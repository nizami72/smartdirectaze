# /etc/smartdirect/smartdirect.env on the server (chmod 600, owner root). No quotes around values.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8083

DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/smartdirect_db
DATASOURCE_USERNAME=smartdirect
DATASOURCE_PASSWORD=

JWT_SECRET=
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://smartdirect.qrfood.az
ADMIN_EMAILS=

DEEPSEEK_API_KEY=
OPENAI_API_KEY=

FRONTEND_BASE_URL=https://smartdirect.qrfood.az
WHATSAPP_WEBHOOK_URL=https://smartdirect.qrfood.az/webhooks/w
WHATSAPP_WEBHOOK_TOKEN=

# Operator alerts (WhatsApp disconnected) through the master bot
SD_TELEGRAM_BOT_TOKEN=
SD_TELEGRAM_BOT_USERNAME=
SD_TELEGRAM_ADMIN_ID=
SD_TELEGRAM_WEBHOOK_URL=

PRODUCT_PHOTO_DIR=/opt/smartdirect/photo
PRODUCT_ALIASES_FILE_PATH=classpath:data/product_aliaces.txt

# Required by the config but unused by the WhatsApp MVP (Instagram, Google Sheets)
WEBHOOK_VERIFY_TOKEN=unused
ACCESS_TOKEN=unused
ACCESS_TOKEN_2=unused
SPREADSHEET_ID=unused
CREDENTIALS_PATH=/opt/smartdirect/unused.json
